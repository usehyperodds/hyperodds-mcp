{
  "name": "@hyperodds/mcp",
  "version": "0.1.0",
  "description": "Read-only Hyperliquid HIP-4 outcome market data for MCP clients: markets from every deployer, fair lines, rule comparisons and new listings.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hyperliquid",
    "hip-4",
    "outcome-markets",
    "prediction-markets",
    "hyperodds"
  ],
  "homepage": "https://github.com/usehyperodds/hyperodds-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usehyperodds/hyperodds-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/usehyperodds/hyperodds-mcp/issues"
  },
  "license": "MIT",
  "author": "Hyperodds <dev@usehyperodds.com> (https://usehyperodds.com)",
  "type": "module",
  "bin": {
    "hyperodds-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test test/bridge.test.js test/cli.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
