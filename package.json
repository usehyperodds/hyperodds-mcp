{
  "name": "@hyperodds/mcp",
  "version": "0.2.0",
  "description": "Stdio bridge to the hosted Hyperodds MCP server: Hyperliquid HIP-4 outcome market data for local MCP clients, and forecasts signed on your machine for Hyperodds' public record.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hyperliquid",
    "hip-4",
    "outcome-markets",
    "prediction-markets",
    "forecasting",
    "hyperodds"
  ],
  "homepage": "https://github.com/usehyperodds/hyperodds-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usehyperodds/hyperodds-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/usehyperodds/hyperodds-mcp/issues"
  },
  "license": "MIT",
  "author": "Hyperodds <dev@usehyperodds.com> (https://usehyperodds.com)",
  "type": "module",
  "bin": {
    "hyperodds-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test test/forecast.test.js test/key.test.js test/bridge.test.js test/cli.test.js test/mcpb.test.js",
    "mcpb": "npm run build && node scripts/mcpb.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
